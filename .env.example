# QQ AI Bot 环境变量配置
# 复制此文件为 .env 并填入真实值

# DeepSeek API (主对话模型)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 通义千问 (容灾 + 视觉):
# - qwen provider 作为 DeepSeek 的备用对话模型(容灾)，复用视觉的 key/base_url
# - 若视觉 key 是阿里云百炼"专属业务空间"的，base_url 必须用该空间专属地址，
#   否则鉴权失败。普通 DashScope Key 才用默认地址。
VISION_API_KEY=sk-your-dashscope-key
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max
QWEN_MODEL=qwen-plus            # 容灾对话模型名

# 博查搜索 API (联网搜索)
SEARCH_API_KEY=your-bocha-key

# 管理员 QQ 号 (资料变更通知)
ADMIN_QQ=0
