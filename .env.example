# QQ AI Bot 环境变量配置
# 复制此文件为 .env 并填入真实值

# DeepSeek API (主对话模型)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 通义千问视觉模型 (图片识别)
# 注意: 若 API Key 是阿里云百炼"专属业务空间"创建的, 必须把 VISION_BASE_URL
# 改成该空间的专属 OpenAI 兼容地址 (形如
# https://<workspace-id>.cn-<region>.maas.aliyuncs.com/compatible-mode/v1),
# 否则会鉴权失败。普通 DashScope Key 才用下面的默认地址。
VISION_API_KEY=sk-your-dashscope-key
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max

# 博查搜索 API (联网搜索)
SEARCH_API_KEY=your-bocha-key

# 管理员 QQ 号 (资料变更通知)
ADMIN_QQ=0
